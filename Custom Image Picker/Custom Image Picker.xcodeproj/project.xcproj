      },
    }, {
      "name": "Build XCFramework",
      "id": "0B11E20B30ADCD9600B5EBE8",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# Type a script or drag a script file from your workspace to insert its path.",
            "# The exact name of the scheme from the Manage Schemes menu",
            "SCHEME_NAME=\"Custom Image Picker\"",
            "",
            "# Xcode usually replaces spaces with underscores for the generated framework module",
            "FRAMEWORK_NAME=\"Custom_Image_Picker\" ",
            "",
            "BUILD_DIR=\"${PROJECT_DIR}/build\"",
            "",
            "# Clean the old build directory",
            "rm -rf \"${BUILD_DIR}\"",
            "",
            "# Build for iOS device",
            "xcodebuild archive \\",
            "  -scheme \"${SCHEME_NAME}\" \\",
            "  -configuration Release \\",
            "  -destination 'generic/platform=iOS' \\",
            "  -archivePath \"${BUILD_DIR}/${FRAMEWORK_NAME}-iphoneos.xcarchive\" \\",
            "  SKIP_INSTALL=NO \\",
            "  BUILD_LIBRARIES_FOR_DISTRIBUTION=YES",
            "",
            "# Build for Simulator",
            "xcodebuild archive \\",
            "  -scheme \"${SCHEME_NAME}\" \\",
            "  -configuration Release \\",
            "  -destination 'generic/platform=iOS Simulator' \\",
            "  -archivePath \"${BUILD_DIR}/${FRAMEWORK_NAME}-iphonesimulator.xcarchive\" \\",
            "  SKIP_INSTALL=NO \\",
            "  BUILD_LIBRARIES_FOR_DISTRIBUTION=YES",
            "",
            "# Create XCFramework",
            "xcodebuild -create-xcframework \\",
            "  -framework \"${BUILD_DIR}/${FRAMEWORK_NAME}-iphoneos.xcarchive/Products/Library/Frameworks/${FRAMEWORK_NAME}.framework\" \\",
            "  -framework \"${BUILD_DIR}/${FRAMEWORK_NAME}-iphonesimulator.xcarchive/Products/Library/Frameworks/${FRAMEWORK_NAME}.framework\" \\",
            "  -output \"${BUILD_DIR}/${FRAMEWORK_NAME}.xcframework\"",
            "",
            "# Open the build folder",
            "open \"${BUILD_DIR}\"",
            "",
          ],
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
